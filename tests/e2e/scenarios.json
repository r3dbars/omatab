{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "accept-next-word",
      "initial_text": "Oma Tab",
      "keys": [
        "Tab"
      ],
      "expected_text": "Oma Tab \u2014 Oma Tab ",
      "expected_visible_suggestion": "is working"
    },
    {
      "id": "accept-full-suggestion-with-shift-tab",
      "initial_text": "Oma Tab",
      "keys": [
        "Shift+Tab"
      ],
      "expected_text": "Oma Tab \u2014 Oma Tab is working",
      "expected_visible_suggestion": false
    },
    {
      "id": "accept-full-suggestion-with-full-accept-key",
      "initial_text": "Oma Tab",
      "keys": [
        "asciitilde"
      ],
      "expected_text": "Oma Tab \u2014 Oma Tab is working",
      "expected_visible_suggestion": false
    },
    {
      "id": "dismiss-inline-suggestion",
      "initial_text": "Oma Tab",
      "keys": [
        "Escape"
      ],
      "expected_text": "Oma Tab",
      "expected_visible_suggestion": false
    },
    {
      "id": "tab-without-suggestion-is-native",
      "initial_text": "",
      "keys": [
        "Tab"
      ],
      "expected_text": "",
      "expected_native_tab": true
    }
  ]
}
