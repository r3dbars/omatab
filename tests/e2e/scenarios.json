      "keys": ["asciitilde"],
      "expected_text": "Tilde — Tilde is working",
      "expected_visible_suggestion": false
    },
    {
      "id": "dismiss-inline-suggestion",
      "initial_text": "Tilde",
      "keys": ["Escape"],
      "expected_text": "Tilde",
      "expected_visible_suggestion": false
    },
    {
      "id": "tab-without-suggestion-is-native",
